# React Native autolinking + Metro cannot follow pnpm's default isolated/symlinked
# node_modules layout. A flat (hoisted) store — the same shape npm/yarn produce —
# is required for Expo SDK 56. Do NOT switch to the isolated linker.
node-linker=hoisted

# Reduce peer-dependency churn with Expo's large peer graph.
auto-install-peers=true
strict-peer-dependencies=false
