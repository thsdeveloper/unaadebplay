{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@repo/types": ["../../../packages/types/src"],
      "@repo/db-types": ["../../../packages/db-types/src"],
      "@repo/validation": ["../../../packages/validation/src"],
      "@repo/api-client": ["../../../packages/api-client/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
