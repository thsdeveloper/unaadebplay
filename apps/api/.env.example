# Fastify API — server-only environment. NEVER expose SUPABASE_SECRET_KEY to a client bundle.
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

SUPABASE_URL=https://vwbybajzwhezergooimn.supabase.co
# Publishable key (used to build the per-request, RLS-scoped user client)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tAX2uxfJb0cG3zi0RrlHUg_ltrBFmwM
# Secret / service-role key — get it from the Supabase dashboard (Project Settings > API keys).
# Required for admin writes (RLS bypass). Keep it out of git and out of any client.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional — derived from SUPABASE_URL when omitted:
# SUPABASE_JWT_ISSUER=https://vwbybajzwhezergooimn.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://vwbybajzwhezergooimn.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated allowed origins (admin URL + Expo dev). '*' in dev only.
CORS_ORIGINS=*
